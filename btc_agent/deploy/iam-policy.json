{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBtcAgentParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/btc-agent",
        "arn:aws:ssm:*:*:parameter/btc-agent/*"
      ]
    },
    {
      "Sid": "DecryptBtcAgentParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadWriteDatabaseBackups",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::btc-agent-934912969749-eu-west-2-an/btc-agent/*"
    },
    {
      "Sid": "CheckWhetherABackupExists",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::btc-agent-934912969749-eu-west-2-an"
    }
  ]
}
